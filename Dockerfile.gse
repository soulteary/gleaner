# syntax=docker/dockerfile:1

# Pure-Go image using GSE segmenter (no CGO).
FROM golang:1.27.4-alpine3.24@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS builder
WORKDIR /src
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ENV CGO_ENABLED=0
ENV GLEANER_SEGMENT_BACKEND=gse
RUN go build -o /out/gleaner-server ./cmd/gleaner-server

FROM alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /out/gleaner-server /app/gleaner-server
EXPOSE 3824
ENV GLEANER_HOST=0.0.0.0
ENV GLEANER_PORT=3824
ENV GLEANER_SEGMENT_BACKEND=gse
CMD ["/app/gleaner-server"]
